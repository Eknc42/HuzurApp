# Required for grounded answer generation
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_VALIDATOR_MODEL=llama-3.1-8b-instant

# Configure one search provider for international and madhhab sources.
# Priority: Brave, Google Custom Search, Serper. Diyanet uses its official search directly.
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
SERPER_API_KEY=

PORT=3000
